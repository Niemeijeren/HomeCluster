# Values currently written into the manifests. Maintained by configure.sh;
# edit config.env instead.

# Base domain. Apps are served at <app>.$DOMAIN (jellyfin, site, argocd).
DOMAIN=example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@example.com
# The Git repo Argo CD syncs from: your fork of this repo.
REPO_URL=https://github.com/your-github-user/HomeCluster.git
# Host directory with movies/, tv/, photos/, documents/.
MEDIA_PATH=/srv/media
# UID and GID that own MEDIA_PATH (the backup job runs as this user).
MEDIA_UID=1000
# S3-compatible bucket and endpoint host for backups (Cloudflare R2 shown).
S3_BUCKET=homecluster-backups
S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
# The node's Tailscale IP (`tailscale ip -4`), same as node-ip in
# host/k3s/config.yaml. Pods reach the API server at this address.
NODE_IP=100.64.0.10
# Optional, off by default: one LAN device allowed to reach Jellyfin directly
# over plain HTTP (e.g. a TV without a Tailscale client), as a /32 with a DHCP
# reservation. To turn it on, set it here, run configure.sh, and uncomment
# service-lan.yaml in apps/jellyfin/kustomization.yaml. The placeholder is a
# documentation address (RFC 5737) that matches no real device.
LAN_CLIENT_IP=192.0.2.1/32
