# Values currently written into the manifests. Maintained by configure.sh;
# edit config.env instead.

# Base domain. Apps are served at <app>.$DOMAIN (jellyfin, portainer, argocd).
DOMAIN=example.com
# Let's Encrypt account email (expiry notices).
ACME_EMAIL=you@example.com
# The Git repo Argo CD syncs from: your fork of this repo.
REPO_URL=https://github.com/your-github-user/HomeCluster.git
# Host directory with movies/, tv/, photos/, documents/.
MEDIA_PATH=/srv/media
# UID and GID that own MEDIA_PATH (the backup job runs as this user).
MEDIA_UID=1000
# S3-compatible bucket and endpoint host for backups (Cloudflare R2 shown).
S3_BUCKET=homecluster-backups
S3_ENDPOINT=ACCOUNT_ID.r2.cloudflarestorage.com
